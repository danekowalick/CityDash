# Postgres connection string.
# Local (docker compose up -d):
DATABASE_URL=postgresql://citydash:citydash@localhost:55432/citydash
# Production (Neon): postgresql://user:pass@ep-xxx.us-west-2.aws.neon.tech/citydash?sslmode=require

# Identifies this crawler to the sites it fetches. Put a REAL contact address here
# before running ingestion against live sources -- it is how a site operator reaches
# you instead of silently blocking you.
CITYDASH_USER_AGENT="CityDashBot/0.1 (+https://example.org/citydash; contact@example.org)"
